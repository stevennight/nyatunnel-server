# --- Image ---------------------------------------------------------------------------------
NYATUNNEL_IMAGE=ghcr.io/stevennight/nyatunnel-server
NYATUNNEL_VERSION=v0.1.0
# NYATUNNEL_PROJECT=nyatunnel
# NYATUNNEL_CONTAINER=nyatunnel-server

# --- Addresses -----------------------------------------------------------------------------
# Where the console lives and where devices connect (through the reverse proxy).
NYATUNNEL_PUBLIC_URL=https://tunnel.example.com

# Loopback ports the reverse proxy forwards to. Pick ports that are free on this host.
NYATUNNEL_LISTEN=127.0.0.1:8080
NYATUNNEL_INGRESS_LISTEN=127.0.0.1:8081
# Answers the reverse proxy's on-demand TLS question; never expose or proxy it.
NYATUNNEL_INTERNAL_LISTEN=127.0.0.1:8082

# Address the TCP/UDP tunnel ports (port pools, configured in the console) listen on.
NYATUNNEL_PORT_BIND=0.0.0.0

# This server's public addresses; custom domains must resolve to one of them.
# Leave empty to resolve the public host (wrong if it is behind a CDN proxy).
NYATUNNEL_PUBLIC_IPS=

# Optional direct device listener (open it in the firewall); devices fall back to 443 without it.
NYATUNNEL_DIRECT_LISTEN=
NYATUNNEL_DIRECT_ADDR=

# --- Storage (relative to this directory) ----------------------------------------------------
NYATUNNEL_DATA_DIR=./data
# Back this up separately: without it TOTP secrets cannot be opened.
NYATUNNEL_SECRETS_DIR=./secrets

# --- Misc ----------------------------------------------------------------------------------
TZ=Asia/Shanghai
# NYATUNNEL_SESSION_TTL=720h
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=3
