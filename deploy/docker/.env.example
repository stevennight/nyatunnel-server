NYATUNNEL_IMAGE=ghcr.io/stevennight/nyatunnel-server
NYATUNNEL_VERSION=v0.1.0

# Where the console lives and where devices connect (through Caddy).
NYATUNNEL_PUBLIC_URL=https://tunnel.example.com

# This server's public addresses; custom domains must point here. Leave empty to resolve the
# public host (wrong if it is behind a CDN such as Cloudflare's proxy).
# NYATUNNEL_PUBLIC_IPS=203.0.113.10,2001:db8::10

# Optional direct device listener (open this port in the firewall); devices fall back to 443.
# NYATUNNEL_DIRECT_LISTEN=0.0.0.0:7443
# NYATUNNEL_DIRECT_ADDR=tunnel.example.com:7443
